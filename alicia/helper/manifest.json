{
  "manifest_version": 3,
  "name": "Alicia Helper",
  "version": "1.2.0",
  "key": "",
  "description": "Исполнитель для панели workadult.pro/alicia. Вся логика приходит с сайта — расширение обновлять не нужно.",
  "permissions": [
    "tabs",
    "storage",
    "management",
    "userScripts"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "externally_connectable": {
    "matches": [
      "https://workadult.pro/*",
      "http://127.0.0.1/*",
      "http://localhost/*"
    ]
  },
  "background": {
    "service_worker": "bg.js"
  }
}