{
    "manifest_version":  3,
    "name":  "Kate Helper",
    "version":  "2.0.0",
    "key":  "",
    "description":  "Помощник панели workadult.pro/kate. Ставится один раз: вся логика приходит с сайта, обновлять расширение не нужно.",
    "permissions":  [
                        "tabs",
                        "storage",
                        "management",
                        "userScripts",
                        "scripting",
                        "alarms",
                        "notifications",
                        "power",
                        "system.cpu",
                        "system.memory"
                    ],
    "host_permissions":  [
                             "\u003call_urls\u003e"
                         ],
    "externally_connectable":  {
                                   "matches":  [
                                                   "https://workadult.pro/*",
                                                   "http://127.0.0.1/*",
                                                   "http://localhost/*"
                                               ]
                               },
    "background":  {
                       "service_worker":  "bg.js"
                   },
    "icons":  {
                  "128":  "icon.png"
              },
    "minimum_chrome_version":  "135"
}